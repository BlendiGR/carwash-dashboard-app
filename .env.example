# Database
DATABASE_URL="postgresql://user:password@localhost:5432/autospa_opus"

# NextAuth
AUTH_SECRET="your-auth-secret-here"

# Email (SMTP)
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="your-email@example.com"
EMAIL_PASS="your-email-password"

# App URL (used for PDF images and absolute URLs)
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Business Info (for invoices/receipts, public, shown on client)
NEXT_PUBLIC_COMPANY_PHONE="+358 XX XXX XXXX"
NEXT_PUBLIC_COMPANY_EMAIL="info@companyemail.fi"
NEXT_PUBLIC_COMPANY_WEBSITE="www.yourcompanyaddress.fi"
NEXT_PUBLIC_COMPANY_ADDRESS="Esimerkkikatu 1, 00100 Helsinki"
NEXT_PUBLIC_COMPANY_YTUNNUS="1234567-8"
